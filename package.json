{
  "name": "prepare-to-interview",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @prepare-to-interview/client build && pnpm --filter @prepare-to-interview/server start",
    "check": "pnpm run test && pnpm run lint && pnpm run typecheck && pnpm run e2e",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm -r --parallel typecheck",
    "e2e": "pnpm --filter @prepare-to-interview/client build && pnpm --filter @prepare-to-interview/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
